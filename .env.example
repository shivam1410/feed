# Copy this file to `.env` (which is git-ignored) and fill in the values.
# NEVER commit `.env`. Rotate any secret that gets exposed.

# Only needed if you push to GitHub over HTTPS (e.g. the repo is on a different
# account than your SSH key). If your SSH key can push, leave this blank.
GITHUB_TOKEN=

# Notion integration — used by the backend that handles "Save to Notion".
# Create an internal integration at https://www.notion.so/my-integrations,
# share your target database with it, then paste the values here.
NOTION_TOKEN=
NOTION_DATABASE_ID=
